# Garmin
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
GARMIN_DEFAULT_SCOPE=

# Polar
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
