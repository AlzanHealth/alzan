{
  "openapi": "3.0.0",
  "paths": {
    "/users/search": {
      "get": {
        "operationId": "searchUsers",
        "parameters": [
          { "name": "q", "required": true, "in": "query", "schema": { "type": "string" } },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": { "minimum": 1, "default": 10, "type": "number" }
          },
          {
            "name": "offset",
            "required": true,
            "in": "query",
            "schema": { "minimum": 0, "default": 0, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfileDto" } }
              }
            }
          }
        },
        "summary": "Search users",
        "tags": ["User"]
      }
    },
    "/users/{userId}/follow": {
      "post": {
        "operationId": "followUser",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": {
          "201": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoidResponse" } } }
          }
        },
        "summary": "Follow a user",
        "tags": ["User"]
      }
    },
    "/users/{userId}/accept": {
      "post": {
        "operationId": "acceptFollowRequest",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": {
          "201": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoidResponse" } } }
          }
        },
        "summary": "Accept a follow request",
        "tags": ["User"]
      }
    },
    "/users/{userId}/reject": {
      "post": {
        "operationId": "rejectFollowRequest",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": {
          "201": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoidResponse" } } }
          }
        },
        "summary": "Reject a follow request",
        "tags": ["User"]
      }
    },
    "/users/{userId}/unfollow": {
      "post": {
        "operationId": "unfollowUser",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": {
          "201": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoidResponse" } } }
          }
        },
        "summary": "Unfollow a user",
        "tags": ["User"]
      }
    },
    "/users/{userId}/followers": {
      "get": {
        "operationId": "getFollowers",
        "parameters": [
          { "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": { "minimum": 1, "default": 10, "type": "number" }
          },
          {
            "name": "offset",
            "required": true,
            "in": "query",
            "schema": { "minimum": 0, "default": 0, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfileDto" } }
              }
            }
          }
        },
        "summary": "Get followers of the user provided",
        "tags": ["User"]
      }
    },
    "/users/{userId}/following": {
      "get": {
        "operationId": "getFollowing",
        "parameters": [
          { "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": { "minimum": 1, "default": 10, "type": "number" }
          },
          {
            "name": "offset",
            "required": true,
            "in": "query",
            "schema": { "minimum": 0, "default": 0, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfileDto" } }
              }
            }
          }
        },
        "summary": "Get following of the user provided",
        "tags": ["User"]
      }
    },
    "/users/{userId}": {
      "get": {
        "operationId": "getProfile",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfileDto" } } }
          }
        },
        "summary": "Get user profile by id",
        "tags": ["User"]
      }
    },
    "/oauth/{provider}/authorize": {
      "get": {
        "operationId": "getAuthorizationUrl",
        "parameters": [
          { "name": "provider", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "user_id",
            "required": true,
            "in": "query",
            "description": "User ID to associate with the connection",
            "schema": { "example": "4424c5d6-5751-4038-aa39-bd85895ddb78", "type": "string" }
          },
          {
            "name": "redirect_uri",
            "required": false,
            "in": "query",
            "description": "Optional custom redirect URI after authorization",
            "schema": { "example": "alzan://oauth/success", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizationResponseDto" } } }
          }
        },
        "tags": ["Providers"]
      }
    },
    "/oauth/{provider}/callback": {
      "get": {
        "operationId": "oauthCallback",
        "parameters": [
          { "name": "provider", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "code",
            "required": false,
            "in": "query",
            "description": "Authorization code returned by the provider",
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "description": "State string returned by the provider",
            "schema": { "type": "string" }
          },
          {
            "name": "error",
            "required": false,
            "in": "query",
            "description": "Error code if the authorization failed",
            "schema": { "type": "string" }
          },
          {
            "name": "error_description",
            "required": false,
            "in": "query",
            "description": "Human-readable error description",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "" } },
        "tags": ["Providers"]
      }
    },
    "/oauth/success": {
      "get": {
        "operationId": "oauthSuccess",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "query",
            "description": "Provider identifier",
            "schema": { "example": "strava", "type": "string" }
          },
          {
            "name": "user_id",
            "required": true,
            "in": "query",
            "description": "User ID associated with the connection",
            "schema": { "example": "4424c5d6-5751-4038-aa39-bd85895ddb78", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthSuccessResponseDto" } } }
          }
        },
        "tags": ["Providers"]
      }
    },
    "/oauth/error": {
      "get": {
        "operationId": "oauthError",
        "parameters": [
          {
            "name": "message",
            "required": false,
            "in": "query",
            "description": "Error message to display",
            "schema": { "example": "OAuth authentication failed", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OAuthErrorResponseDto" } } }
          }
        },
        "tags": ["Providers"]
      }
    }
  },
  "info": {
    "title": "Alzan Full API",
    "description": "Unified API for frontend generation",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [{ "name": "Alzan api", "description": "" }],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter a valid Supabase user token"
      }
    },
    "schemas": {
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "User ID", "example": "4424c5d6-5751-4038-aa39-bd85895ddb78" },
          "username": { "type": "string", "nullable": true, "description": "Unique username", "example": "johndoe" },
          "display_name": {
            "type": "string",
            "nullable": true,
            "description": "Display name shown publicly",
            "example": "John Doe"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "URL of the user's avatar image",
            "example": "https://cdn.alzan.com/avatars/johndoe.png"
          },
          "followers_count": { "type": "number", "description": "Total number of followers", "example": 42 },
          "following_count": {
            "type": "number",
            "description": "Total number of accounts the user is following",
            "example": 17
          },
          "is_following": {
            "type": "boolean",
            "description": "Whether the authenticated user is currently following this user",
            "example": false
          }
        },
        "required": ["id", "username", "followers_count", "following_count"]
      },
      "VoidResponse": { "type": "object", "properties": {} },
      "AuthorizationResponseDto": {
        "type": "object",
        "properties": {
          "authorization_url": {
            "type": "string",
            "description": "The URL to redirect the user to for authorization",
            "example": "https://www.strava.com/oauth/mobile/authorize?..."
          },
          "state": {
            "type": "string",
            "description": "Random state string used to prevent CSRF",
            "example": "abc123def456"
          }
        },
        "required": ["authorization_url", "state"]
      },
      "OAuthSuccessResponseDto": {
        "type": "object",
        "properties": {
          "success": { "description": "Indicates if the operation was successful", "example": true, "type": "boolean" },
          "message": { "type": "string", "description": "Success message" },
          "user_id": {
            "type": "string",
            "description": "User ID associated with the connection",
            "example": "4424c5d6-5751-4038-aa39-bd85895ddb78"
          },
          "provider": { "type": "string", "description": "Provider identifier", "example": "strava" }
        },
        "required": ["success", "message", "user_id", "provider"]
      },
      "OAuthErrorResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "description": "Indicates if the operation was successful",
            "example": false,
            "type": "boolean"
          },
          "message": { "type": "string", "description": "Error message" }
        },
        "required": ["success", "message"]
      }
    }
  },
  "security": [{ "bearer-auth": [] }]
}
