  "info": {
    "title": "Alzan Full API",
    "description": "Unified API for frontend generation",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [{ "name": "Alzan api", "description": "" }],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter a valid Supabase user token"
      }
    },
    "schemas": {
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "User ID", "example": "4424c5d6-5751-4038-aa39-bd85895ddb78" },
          "username": { "type": "string", "nullable": true, "description": "Unique username", "example": "johndoe" },
          "display_name": {
            "type": "string",
            "nullable": true,
            "description": "Display name shown publicly",
            "example": "John Doe"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "URL of the user's avatar image",
            "example": "https://cdn.alzan.com/avatars/johndoe.png"
          },
          "followers_count": { "type": "number", "description": "Total number of followers", "example": 42 },
          "following_count": {
            "type": "number",
            "description": "Total number of accounts the user is following",
            "example": 17
          },
          "is_following": {
            "type": "boolean",
            "description": "Whether the authenticated user is currently following this user",
            "example": false
          }
        },
        "required": ["id", "username", "followers_count", "following_count"]
      },
      "VoidResponse": { "type": "object", "properties": {} },
      "AuthorizationResponseDto": {
        "type": "object",
        "properties": {
          "authorization_url": {
            "type": "string",
            "description": "The URL to redirect the user to for authorization",
            "example": "https://www.strava.com/oauth/mobile/authorize?..."
          },
          "state": {
            "type": "string",
            "description": "Random state string used to prevent CSRF",
            "example": "abc123def456"
          }
        },
        "required": ["authorization_url", "state"]
      },
      "OAuthSuccessResponseDto": {
        "type": "object",
        "properties": {
          "success": { "description": "Indicates if the operation was successful", "example": true, "type": "boolean" },
          "message": { "type": "string", "description": "Success message" },
          "user_id": {
            "type": "string",
            "description": "User ID associated with the connection",
            "example": "4424c5d6-5751-4038-aa39-bd85895ddb78"
          },
          "provider": { "type": "string", "description": "Provider identifier", "example": "strava" }
        },
        "required": ["success", "message", "user_id", "provider"]
      },
      "OAuthErrorResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "description": "Indicates if the operation was successful",
            "example": false,
            "type": "boolean"
          },
          "message": { "type": "string", "description": "Error message" }
        },
        "required": ["success", "message"]
      },
      "ImportedStrengthActivitySummaryDto": {
        "type": "object",
        "properties": {
          "provider": { "type": "object" },
          "sourceFileType": { "type": "object" },
          "startedAt": { "type": "string", "nullable": true },
          "endedAt": { "type": "string", "nullable": true },
          "durationSeconds": { "type": "number", "nullable": true },
          "caloriesKcal": { "type": "number", "nullable": true },
          "avgHeartRate": { "type": "number", "nullable": true },
          "maxHeartRate": { "type": "number", "nullable": true },
          "minHeartRate": { "type": "number", "nullable": true },
          "totalSteps": { "type": "number", "nullable": true },
          "recoveryTimeSeconds": { "type": "number", "nullable": true },
          "epoc": { "type": "number", "nullable": true },
          "pte": { "type": "number", "nullable": true },
          "tss": { "type": "number", "nullable": true },
          "trainingLoadPeak": { "type": "number", "nullable": true },
          "device": { "type": "object", "nullable": true },
          "heartRateZones": { "type": "array", "items": { "type": "object" } },
          "heartRateStream": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["provider", "sourceFileType", "heartRateZones", "heartRateStream"]
      },
      "ParsedRouteImportDto": {
        "type": "object",
        "properties": {
          "polyline": { "type": "string" },
          "summary": { "type": "object" },
          "details": { "type": "object" }
        },
        "required": ["polyline", "summary", "details"]
      },
      "ApplyRouteActivityImportResponseDto": {
        "type": "object",
        "properties": { "format": { "type": "object" }, "parsed": { "type": "object" } },
        "required": ["format", "parsed"]
      },
      "ProviderOriginOutputDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "source_channel": { "type": "string" },
          "provider": { "type": "object" },
          "source_package": { "type": "string", "nullable": true },
          "source_provider_key": { "type": "string", "nullable": true },
          "display_name": { "type": "string", "nullable": true },
          "platform": { "type": "string", "nullable": true },
          "last_seen_at": { "type": "string" }
        },
        "required": [
          "id",
          "source_channel",
          "provider",
          "source_package",
          "source_provider_key",
          "display_name",
          "platform",
          "last_seen_at"
        ]
      },
      "ProviderOriginDto": {
        "type": "object",
        "properties": {
          "source_channel": {
            "type": "string",
            "enum": ["cloud", "apple_health", "health_connect", "file_import", "manual"]
          },
          "provider": {
            "type": "string",
            "enum": [
              "strava",
              "garmin",
              "polar",
              "suunto",
              "whoop",
              "oura",
              "fitbit",
              "ultrahuman",
              "apple_health",
              "health_connect",
              "manual",
              "coros"
            ]
          },
          "source_package": { "type": "string" },
          "source_provider_key": { "type": "string" },
          "display_name": { "type": "string" },
          "platform": { "type": "string" },
          "raw_payload": { "type": "object" }
        },
        "required": ["source_channel", "provider"]
      },
      "UpsertProviderOriginsDto": {
        "type": "object",
        "properties": { "origins": { "type": "array", "items": { "$ref": "#/components/schemas/ProviderOriginDto" } } },
        "required": ["origins"]
      },
      "SelectHealthConnectOriginDto": {
        "type": "object",
        "properties": { "origin_id": { "type": "string", "format": "uuid" } },
        "required": ["origin_id"]
      },
      "LocalHealthSyncRecordDto": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "enum": ["activity", "daily_activity", "sleep", "recovery", "health_sample", "vo2_max", "weight"]
          },
          "source_record_id": { "type": "string" },
          "source_updated_at": { "type": "string" },
          "source_package": { "type": "string" },
          "metric_type": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "recorded_at": { "type": "string" },
          "payload": { "type": "object" }
        },
        "required": ["object_type", "payload"]
      },
      "LocalHealthSyncStateDto": {
        "type": "object",
        "properties": {
          "sync_domain": {
            "type": "string",
            "enum": ["activities", "daily_activity", "sleep", "recovery", "health_metrics", "body"]
          },
          "cursor_token": { "type": "string" },
          "anchor_token": { "type": "string" },
          "last_record_at": { "type": "string" }
        },
        "required": ["sync_domain"]
      },
      "LocalHealthSyncDto": {
        "type": "object",
        "properties": {
          "source_channel": { "type": "string", "enum": ["apple_health", "health_connect"] },
          "source_package": { "type": "string" },
          "trace_id": { "type": "string" },
          "origins": { "type": "array", "items": { "$ref": "#/components/schemas/ProviderOriginDto" } },
          "records": { "type": "array", "items": { "$ref": "#/components/schemas/LocalHealthSyncRecordDto" } },
          "sync_states": { "type": "array", "items": { "$ref": "#/components/schemas/LocalHealthSyncStateDto" } }
        },
        "required": ["source_channel", "records"]
      },
      "LocalHealthSyncOutputDto": {
        "type": "object",
        "properties": {
          "activities_imported": { "type": "number" },
          "daily_activities_imported": { "type": "number" },
          "sleeps_imported": { "type": "number" },
          "recoveries_imported": { "type": "number" },
          "health_samples_imported": { "type": "number" },
          "origins_upserted": { "type": "number" }
        },
        "required": [
          "activities_imported",
          "daily_activities_imported",
          "sleeps_imported",
          "recoveries_imported",
          "health_samples_imported",
          "origins_upserted"
        ]
      },
      "CloudProviderSyncOutputDto": {
        "type": "object",
        "properties": {
          "provider": { "type": "string" },
          "job_id": { "type": "string" },
          "status": { "type": "string" },
          "activities_imported": { "type": "number" },
          "activities_skipped": { "type": "number" },
          "activities_updated": { "type": "number" },
          "activities_repaired": { "type": "number" },
          "activities_failed": { "type": "number" },
          "activities_reconciled": { "type": "number" },
          "errors_by_code": { "type": "object" },
          "phase_durations_ms": { "type": "object" },
          "last_success_at": { "type": "string", "nullable": true },
          "health_days_imported": { "type": "number" },
          "health_consent_required": { "type": "boolean" },
          "backfill_complete": { "type": "boolean" },
          "backfill_next_date": { "type": "string", "nullable": true },
          "fit_pending": { "type": "number" }
        },
        "required": ["provider", "activities_imported", "last_success_at"]
      },
      "TemplateAssociationInputDto": {
        "type": "object",
        "properties": {
          "endurance_template_id": { "type": "string", "nullable": true, "format": "uuid" },
          "workout_template_id": { "type": "string", "nullable": true, "format": "uuid" },
          "workout_plan_id": { "type": "string", "format": "uuid" },
          "target_session_id": { "type": "string", "format": "uuid" }
        }
      },
      "ImportReviewSessionOutputDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "description": "Surviving/updated session id after the action."
          }
        },
        "required": ["session_id"]
      },
      "ImportReviewTargetInputDto": {
        "type": "object",
        "properties": { "target_session_id": { "type": "string", "format": "uuid" } }
      },
      "DuplicateMergeInputDto": {
        "type": "object",
        "properties": { "target_session_id": { "type": "string", "format": "uuid" } }
      },
      "StrengthAssignmentInputDto": {
        "type": "object",
        "properties": { "target_session_id": { "type": "string", "format": "uuid" } }
      },
      "CorosWebhookStatusDto": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["ok"] } },
        "required": ["status"]
      },
      "CorosWorkoutPushDto": {
        "type": "object",
        "properties": { "sportDataList": { "type": "array", "maxItems": 100, "items": { "type": "object" } } },
        "required": ["sportDataList"]
      },
      "CorosWebhookResponseDto": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "enum": ["ok"] },
          "result": { "type": "string", "enum": ["0000"] }
        },
        "required": ["message", "result"]
      },
      "CorosCapabilityDto": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "mode": { "type": "string", "enum": ["disabled", "pilot", "public"] },
          "reason": { "type": "string", "enum": ["ready", "not_configured", "restricted"] }
        },
        "required": ["enabled", "mode", "reason"]
      },
      "CorosDisconnectDto": {
        "type": "object",
        "properties": {
          "disconnected": { "type": "boolean" },
          "remote_deauthorization_pending": { "type": "boolean" }
        },
        "required": ["disconnected", "remote_deauthorization_pending"]
      },
      "CorosHistoryImportFileErrorDto": {
        "type": "object",
        "properties": { "fileName": { "type": "string" }, "code": { "type": "string" } },
        "required": ["fileName", "code"]
      },
      "CorosHistoryImportResultDto": {
        "type": "object",
        "properties": {
          "filesImported": { "type": "number" },
          "filesSkipped": { "type": "number" },
          "filesFailed": { "type": "number" },
          "errorsByFile": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CorosHistoryImportFileErrorDto" }
          }
        },
        "required": ["filesImported", "filesSkipped", "filesFailed", "errorsByFile"]
      }
    }
  },
  "security": [{ "bearer-auth": [] }]
}
