{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AppOutputDto" } } }
          }
        },
        "summary": "Returns the application information",
        "tags": ["App"]
      }
    },
    "/users/{userId}": {
      "get": {
        "operationId": "getUserById",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfileDto" } } }
          }
        },
        "summary": "Get user profile by id",
        "tags": ["User"]
      }
    },
    "/users/{userId}/follow": {
      "post": {
        "operationId": "followUser",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": { "201": { "description": "" } },
        "summary": "Follow a user",
        "tags": ["User"]
      }
    },
    "/users/{userId}/accept": {
      "post": {
        "operationId": "acceptFollowRequest",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": { "201": { "description": "" } },
        "summary": "Accept a follow request",
        "tags": ["User"]
      }
    },
    "/users/{userId}/reject": {
      "post": {
        "operationId": "rejectFollowRequest",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": { "201": { "description": "" } },
        "summary": "Reject a follow request",
        "tags": ["User"]
      }
    },
    "/users/{userId}/unfollow": {
      "post": {
        "operationId": "unfollowUser",
        "parameters": [{ "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } }],
        "responses": {
          "201": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VoidResponse" } } }
          }
        },
        "summary": "Unfollow a user",
        "tags": ["User"]
      }
    },
    "/users/{userId}/followers": {
      "get": {
        "operationId": "getFollowers",
        "parameters": [
          { "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": { "minimum": 1, "default": 10, "type": "number" }
          },
          {
            "name": "offset",
            "required": true,
            "in": "query",
            "schema": { "minimum": 0, "default": 0, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfileDto" } }
              }
            }
          }
        },
        "summary": "Get followers of the user provided",
        "tags": ["User"]
      }
    },
    "/users/{userId}/following": {
      "get": {
        "operationId": "getFollowing",
        "parameters": [
          { "name": "userId", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": { "minimum": 1, "default": 10, "type": "number" }
          },
          {
            "name": "offset",
            "required": true,
            "in": "query",
            "schema": { "minimum": 0, "default": 0, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfileDto" } }
              }
            }
          }
        },
        "summary": "Get following of the user provided",
        "tags": ["User"]
      }
    },
    "/users/search": {
      "get": {
        "operationId": "searchUsers",
        "parameters": [
          { "name": "q", "required": true, "in": "query", "schema": { "type": "string" } },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": { "minimum": 1, "default": 10, "type": "number" }
          },
          {
            "name": "offset",
            "required": true,
            "in": "query",
            "schema": { "minimum": 0, "default": 0, "type": "number" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserProfileDto" } }
              }
            }
          }
        },
        "summary": "Search users",
        "tags": ["User"]
      }
    }
  },
  "info": { "title": "Alzan API", "description": "Alzan Backend API", "version": "1.0.0", "contact": {} },
  "tags": [{ "name": "Alzan api", "description": "" }],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter a valid Supabase user token"
      }
    },
    "schemas": {
      "AppOutputDto": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "Status of the request", "example": "ok" },
          "timestamp": {
            "type": "string",
            "description": "Timestamp of the request",
            "example": "2026-01-25T14:26:29.000Z"
          },
          "environment": { "type": "string", "description": "Environment of the request", "example": "local" },
          "baseUrl": { "type": "string", "description": "Base URL of the request", "example": "http://localhost:1111" }
        },
        "required": ["status", "timestamp", "environment", "baseUrl"]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "User ID", "example": "4424c5d6-5751-4038-aa39-bd85895ddb78" },
          "username": { "type": "string", "nullable": true, "description": "Unique username", "example": "johndoe" },
          "display_name": {
            "type": "string",
            "nullable": true,
            "description": "Display name shown publicly",
            "example": "John Doe"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "URL of the user's avatar image",
            "example": "https://cdn.alzan.com/avatars/johndoe.png"
          },
          "followers_count": { "type": "number", "description": "Total number of followers", "example": 42 },
          "following_count": {
            "type": "number",
            "description": "Total number of accounts the user is following",
            "example": 17
          },
          "is_following": {
            "type": "boolean",
            "description": "Whether the authenticated user is currently following this user",
            "example": false
          }
        },
        "required": ["id", "username", "followers_count", "following_count"]
      },
      "VoidResponse": { "type": "object", "properties": {} }
    }
  },
  "security": [{ "bearer-auth": [] }]
}
