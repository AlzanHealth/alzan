    "/oauth/{provider}/authorize": {
      "get": {
        "operationId": "getAuthorizationUrl",
        "parameters": [
          { "name": "provider", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "user_id",
            "required": true,
            "in": "query",
            "description": "User ID to associate with the connection",
            "schema": { "example": "4424c5d6-5751-4038-aa39-bd85895ddb78", "type": "string" }
          },
          {
            "name": "redirect_uri",
            "required": false,
            "in": "query",
            "description": "Optional custom redirect URI after authorization",
            "schema": { "example": "alzan://oauth/success", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorizationResponseDto" } } }
          }
        },
        "tags": ["Providers"]
      }
    },
    "/oauth/{provider}/callback": {
      "get": {
        "operationId": "oauthCallback",
        "parameters": [
          { "name": "provider", "required": true, "in": "path", "schema": { "type": "string" } },
          {
            "name": "code",
            "required": false,
            "in": "query",
            "description": "Authorization code returned by the provider",
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "description": "State string returned by the provider",
            "schema": { "type": "string" }
          },
          {
            "name": "error",
            "required": false,
            "in": "query",
            "description": "Error code if the authorization failed",
            "schema": { "type": "string" }
          },
          {
            "name": "error_description",
            "required": false,
            "in": "query",
            "description": "Human-readable error description",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "" } },
        "tags": ["Providers"]
      }
    },
    "/oauth/success": {
      "get": {
        "operationId": "oauthSuccess",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "query",
            "description": "Provider identifier",
            "schema": { "example": "strava", "type": "string" }
          },
          {
            "name": "user_id",
            "required": true,
            "in": "query",
            "description": "User ID associated with the connection",
            "schema": { "example": "4424c5d6-5751-4038-aa39-bd85895ddb78", "type": "string" }
