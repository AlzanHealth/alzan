# ── Local development ───────────────────────────────────────────────────────────────────
FE_PORT=8082

# ── Supabase Common ─────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# ── Backend ───────────────────────────────────────────────────────────────────
BE_PORT=1111
NODE_ENV=local
BACKEND_URL=http://localhost:${BE_PORT}
FRONTEND_URL=http://localhost:${FE_PORT}
SUPABASE_SERVICE_ROLE_KEY=

# OAuth Providers
# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_DEFAULT_SCOPE=activity:read_all,profile:read_all
STRAVA_REDIRECT_URI=${BACKEND_URL}/oauth/callback

# Garmin
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
GARMIN_DEFAULT_SCOPE=

# Polar
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=
POLAR_DEFAULT_SCOPE=accesslink.read_all

# Suunto
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_REDIRECT_URI=
SUUNTO_DEFAULT_SCOPE=
SUUNTO_SUBSCRIPTION_KEY=
SUUNTO_247_ENABLED=false
SUUNTO_247_SUBSCRIPTION_KEY=

# COROS (keep disabled until COROS issues sandbox credentials)
COROS_API_BASE_URL=https://opentest.coros.com
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
COROS_REDIRECT_URI=https://api.alzanhealth.com/oauth/coros/callback
COROS_ROLLOUT_MODE=disabled
COROS_PILOT_USER_IDS=
COROS_TOKEN_ENCRYPTION_KEY_V1=
COROS_FIT_ALLOWED_HOSTS=oss.coros.com
COROS_WEBHOOK_CLIENT=
COROS_WEBHOOK_SECRET=

# Whoop
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_DEFAULT_SCOPE=offline read:cycles read:sleep read:recovery read:workout

# Oura
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
OURA_DEFAULT_SCOPE=personal daily activity heartrate workout session spo2 ring_configuration heart_health

# Fitbit
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=
FITBIT_DEFAULT_SCOPE=activity heartrate sleep profile

# Ultrahuman
ULTRAHUMAN_CLIENT_ID=
ULTRAHUMAN_CLIENT_SECRET=
ULTRAHUMAN_REDIRECT_URI=
ULTRAHUMAN_DEFAULT_SCOPE=ring_data cgm_data profile

# ── Frontend ───────────────────────────────────────────────────────────────────
NUTRITION_API_BASE_URL=
WEBSITE_URL=
