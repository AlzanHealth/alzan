# ── Cloud Supabase overrides (template) ─────────────────────────────────────
# Copy this file to `.env.cloud` (gitignored) and fill in the real values.
# Layered on top of the root .env by `pnpm env:sync:cloud` (sync-env.js --cloud).
# Only the keys below are overridden; ports, backend URL and OAuth stay local.
#
# Used only by the cloud start commands (start:web:cloud / ios:cloud /
# android:cloud), which refuse to run outside the `main` branch because a PR's
# migrations are not yet applied to the cloud database.

# Project URL → Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Client (publishable / anon) key → Project Settings → API
SUPABASE_ANON_KEY=

# Server-side key (bypasses RLS) → Project Settings → API → service_role / secret
SUPABASE_SERVICE_ROLE_KEY=
