# =============================================================================
# Alzan Monorepo — Root .gitignore
# Covers both alzan-be (NestJS) and alzan-fe (Expo/React Native)
# =============================================================================

# ─── Environment ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.example.env
!.env.cloud.example
.env*.local

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
out/
build/Release

# alzan-be specific build
alzan-be/dist/

# alzan-fe specific build / native generated
alzan-fe/dist/
alzan-fe/web-build/
alzan-fe/ios/
alzan-fe/android/
alzan-fe/.expo/
alzan-fe/expo-env.d.ts
alzan-fe/src/openapi/generated/

# Supabase local state
supabase/.branches/
supabase/.temp/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ─── Test / Coverage ─────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Native / Mobile certs & keys ────────────────────────────────────────────
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ─── Expo / Metro ────────────────────────────────────────────────────────────
.metro-health-check*

# ─── Cache & tool artifacts ──────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDEs & editors ──────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode-test

# ─── Framework-specific ──────────────────────────────────────────────────────
# Next.js
.next/
# Nuxt.js
.nuxt/
# SvelteKit
.svelte-kit/
# VitePress
**/.vitepress/dist
**/.vitepress/cache
# Docusaurus
.docusaurus/
# Serverless
.serverless/
# FuseBox
.fusebox/
# DynamoDB
.dynamodb/
# Firebase
.firebase/
# Grunt
.grunt/
# Bower
bower_components/
# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─── Misc ────────────────────────────────────────────────────────────────────
*.tgz
*.pid
*.seed
*.pid.lock
.tern-port
.lock-wscript
lib-cov/
pids/
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── Workspace-internal ignore ───────────────────────────────────────────────
alzan-temp/
open-wearables/
.worktrees/
